{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es6",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "paths": {
      "@src*": ["src*"]
    }
  },
  "exclude": ["node_modules"]
}
