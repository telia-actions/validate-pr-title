{
  "name": "validate-pr-title",
  "type": "module",
  "description": "Validate the PR title to match the given prefixes",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@actions/core --external:@actions/github",
    "format": "biome format --write",
    "lint": "biome lint",
    "test": "vitest run",
    "lint-test-build": "npm run lint && npm run test && npm run build"
  },
  "author": "Fredrik Anbacken",
  "license": "MIT",
  "overrides": {
    "minimatch@<=3.1.5": "3.1.5",
    "minimatch@>3 <=10.2.4": "10.2.4",
    "flatted": ">=3.4.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.2.3",
    "esbuild": "0.26.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  }
}
