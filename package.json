{
  "name": "validate-pr-title",
  "type": "module",
  "description": "Validate the PR title to match the given prefixes",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@actions/core --external:@actions/github",
    "format": "prettier . --write",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "lint-test-build": "npm run lint && npm run test && npm run build"
  },
  "author": "Fredrik Anbacken",
  "license": "MIT",
  "overrides": {
    "minimatch@<=3.1.5": "3.1.5",
    "minimatch@>3 <=10.2.4": "10.2.4",
    "flatted": ">=3.4.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@typescript-eslint/parser": "^8.55.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-github": "^6.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  }
}
